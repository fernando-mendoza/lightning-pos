# Copia este archivo a .env y ajusta los valores antes de `docker compose up`.
# Todas las variables del backend usan el prefijo LPOS_ (ver backend/config.py).

# ---------- App ----------
LPOS_DEBUG=false

# ---------- LNbits (vive en el VPS, fuera de docker-compose) ----------
LPOS_LNBITS_URL=https://lnbits.tu-dominio.com
LPOS_LNBITS_API_KEY=cambia-esto-admin-api-key
LPOS_LNBITS_WEBHOOK_SECRET=cambia-esto-webhook-secret

# ---------- Bitso (tipo de cambio MXN/BTC) ----------
LPOS_BITSO_API_URL=https://api.bitso.com/v3
LPOS_EXCHANGE_RATE_TTL=45

# ---------- Auth ----------
# Generar con: python -c "import hashlib; print(hashlib.sha256(b'TU_PIN').hexdigest())"
LPOS_PIN_HASH=

# ---------- Invoice ----------
LPOS_INVOICE_EXPIRY=300

# ---------- Frontend ----------
# Puerto expuesto en el host; Caddy en el VPS hara reverse proxy a este puerto.
FRONTEND_PORT=8080
