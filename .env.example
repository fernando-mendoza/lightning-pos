# Copia este archivo a .env y ajusta los valores antes de `docker compose up`.
# Todas las variables del backend usan el prefijo LPOS_ (ver backend/config.py).

# ---------- App ----------
LPOS_DEBUG=false

# ---------- LNbits ----------
# Produccion: vive externo (VPS con Phoenixd).
# Desarrollo: usar docker-compose.dev.yml (override que levanta LNbits FakeWallet).
#             El override setea LPOS_LNBITS_URL=http://lnbits:5000 automaticamente.
#             Solo tenes que llenar LPOS_LNBITS_API_KEY con la admin key que genera
#             LNbits al crear un wallet en http://localhost:5001.
LPOS_LNBITS_URL=https://lnbits.tu-dominio.com
LPOS_LNBITS_API_KEY=cambia-esto-admin-api-key
LPOS_LNBITS_WEBHOOK_SECRET=cambia-esto-webhook-secret

# URL publica del backend (la que LNbits usa para el webhook de pago).
# Dev con docker-compose.dev.yml: el override la setea a http://backend:8000.
# Produccion: dominio publico del backend o URL interna si LNbits vive en misma red.
LPOS_WEBHOOK_BASE_URL=https://pos.tu-dominio.com

# ---------- Bitso (tipo de cambio MXN/BTC) ----------
LPOS_BITSO_API_URL=https://api.bitso.com/v3
LPOS_EXCHANGE_RATE_TTL=45

# ---------- Auth ----------
# Generar con: python -c "import hashlib; print(hashlib.sha256(b'TU_PIN').hexdigest())"
LPOS_PIN_HASH=

# Secret para firmar JWT. En PRODUCCION es obligatorio setearlo explicitamente.
# En dev, si queda vacio se genera uno efimero por boot (tokens invalidan al reiniciar).
# Generar: openssl rand -hex 32
LPOS_JWT_SECRET=
LPOS_JWT_TTL_SECONDS=2592000

# Rate limit de intentos de PIN
LPOS_MAX_PIN_ATTEMPTS=5
LPOS_PIN_LOCKOUT_WINDOW_SECONDS=900

# CORS: origenes permitidos, separados por coma.
LPOS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8090

# ---------- Invoice ----------
LPOS_INVOICE_EXPIRY=300

# ---------- Frontend ----------
# Puerto expuesto en el host; Caddy en el VPS hara reverse proxy a este puerto.
FRONTEND_PORT=8080

# ---------- Dev (docker-compose.dev.yml) ----------
# Puerto expuesto en el host para LNbits FakeWallet (default 5001).
LNBITS_PORT=5001
# Secreto interno de FakeWallet; cualquier string sirve en dev.
FAKE_WALLET_SECRET=dev-fake-wallet-secret-change-me
