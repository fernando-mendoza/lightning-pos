FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements-test.txt pytest.ini ./
RUN pip install --no-cache-dir -r requirements-test.txt

COPY tests/ ./tests/

CMD ["pytest", "-v", "-s"]
