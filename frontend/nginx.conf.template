# Template procesado por envsubst al arrancar el container (feature estandar
# de la imagen oficial de nginx: /etc/nginx/templates/*.template).
# Solo se sustituyen variables DEFINIDAS en el environment (ej. ${BACKEND_ORIGIN});
# las variables de runtime de nginx ($host, $uri, ...) quedan intactas.
#
# BACKEND_ORIGIN:
#   - docker-compose local: http://backend:8000 (default en el Dockerfile)
#   - Railway: https://<dominio-publico-del-backend> (el proxy sale por TLS;
#     proxy_ssl_server_name se ignora cuando el upstream es http)

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 2m;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # PWA: service worker must never be cached
    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires 0;
    }

    location = /manifest.json {
        add_header Cache-Control "no-cache" always;
        expires 0;
    }

    # Static build assets use content-hashed filenames => safe to cache long
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        access_log off;
    }

    # API reverse proxy
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        # Host = host del upstream: Railway rutea por Host header
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # WebSocket reverse proxy for payment confirmations
    location /ws/ {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # SPA fallback — any unknown route serves index.html for client-side routing.
    # index.html NO se cachea: referencia los bundles hasheados, asi que una copia
    # vieja en el cache del navegador deja al usuario en una version vieja de la app
    # (los /assets/ si son cacheables para siempre porque llevan hash en el nombre).
    location / {
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri $uri/ /index.html;
    }
}
